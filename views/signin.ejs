<!DOCTYPE html>
<html>
<head>
<title>Sign In - Study Companion</title>
<link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body class="auth-body">
<div class="auth-logo"><span class="logo-icon">&#128214;</span> Study Companion</div>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to continue studying.</p>

    <form method="POST" action="/signin">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Sign In</button>
    </form>

    <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
  </div>
</div>

</body>
</html>