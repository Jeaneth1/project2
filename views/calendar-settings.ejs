<!DOCTYPE html>
<html>
<head>
<title>Schedule Settings</title>
<link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
<%- include('partials/nav') %>

<main class="page-content">
<h1>Schedule Settings</h1>
<p class="subtitle">Set your study window for each day individually. Default is 8:00am to 10:00pm.</p>

<form method="POST" action="/calendar/settings">
  <% days.forEach(function(day) { %>
    <div class="day-settings-row">
      <span class="day-settings-label"><%= day.name %></span>
      <input type="time" name="wake_<%= day.index %>" value="<%= day.wakeTime %>">
      <span>to</span>
      <input type="time" name="sleep_<%= day.index %>" value="<%= day.sleepTime %>">
    </div>
  <% }); %>
  <button type="submit">Save All Days</button>
</form>

<p class="subtitle"><a href="/calendar">Back to calendar</a></p>

</main>
</body>
</html>